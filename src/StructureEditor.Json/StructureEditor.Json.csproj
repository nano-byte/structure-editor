<Project Sdk="Microsoft.NET.Sdk">

  <!-- Build config -->
  <PropertyGroup>
    <AssemblyName>NanoByte.StructureEditor.Json</AssemblyName>
    <RootNamespace>NanoByte.StructureEditor.Json</RootNamespace>
    <Description>System.Text.Json serialization support for split-screen editors for data structures</Description>
    <PackageTags>split-screen;editor;data structures;JSON;System.Text.Json</PackageTags>
    <TargetFrameworks>net472;net10.0</TargetFrameworks>
    <OutputPath>..\..\artifacts\$(Configuration)\</OutputPath>
  </PropertyGroup>
  <PropertyGroup Condition="'$(TargetFramework)'!='net472'">
    <!-- Run nullability analysis only on annotated frameworks -->
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <!-- Dependencies -->
  <ItemGroup>
    <ProjectReference Include="..\StructureEditor\StructureEditor.csproj" />
  </ItemGroup>
  <ItemGroup Condition="'$(TargetFramework)'=='net472'">
    <PackageReference Include="System.Text.Json" Version="11.0.0" />
  </ItemGroup>

</Project>
