<Project Sdk="Microsoft.NET.Sdk">

  <!-- Build config -->
  <PropertyGroup>
    <AssemblyName>NanoByte.StructureEditor.NewtonsoftJson</AssemblyName>
    <RootNamespace>NanoByte.StructureEditor.NewtonsoftJson</RootNamespace>
    <Description>Newtonsoft.Json serialization support for split-screen editors for data structures</Description>
    <PackageTags>split-screen;editor;data structures;JSON;Newtonsoft.Json</PackageTags>
    <TargetFrameworks>net10.0;net9.0;net8.0;net45</TargetFrameworks>
    <OutputPath>..\..\artifacts\$(Configuration)\</OutputPath>
  </PropertyGroup>
  <PropertyGroup Condition="'$(TargetFramework)'!='net45'">
    <!-- Run nullability analysis only on annotated frameworks -->
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <!-- Dependencies -->
  <ItemGroup>
    <ProjectReference Include="..\StructureEditor\StructureEditor.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
  </ItemGroup>

</Project>
